#!/usr/bin/env python3
"""Regenerate secret-rules.json, the rules .githooks/pre-commit checks, from
gitleaks' default rule file.

    .githooks/update-secret-rules [gitleaks.toml | version tag]

With no argument it downloads config/gitleaks.toml from the gitleaks release
named in secret-rules.json; with a tag (v8.30.1) it downloads that release;
with a path it reads that file. Needs Python 3.11+ (tomllib); the hook itself
does not.

The rules are gitleaks', translated from Go's regexp (RE2) syntax to Python's
`re` with the same meaning:
  - a flag group partway through a pattern, `(?i)`, applies to the rest of its
    enclosing group in Go; Python only allows that at the very start, so it
    becomes a scoped group `(?i:...)` closed where the enclosing group ends
  - `\\z` (end of text) becomes `\\Z`; `$` without (?m) is end of text in Go,
    so it becomes `\\Z` too (Python's `$` also matches before a final newline)
  - `\\s` is [\\t\\n\\f\\r ] in Go; Python's also takes \\v, so it is spelled
    out, and `\\S` gains \\v
  - POSIX classes such as [[:alnum:]] are expanded
Patterns compile with re.ASCII, so \\w, \\d and \\b are ASCII-only as in Go.
"""
import json
import os
import re
import sys
import tomllib
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "secret-rules.json")

POSIX = {
    "alnum": "0-9A-Za-z", "alpha": "A-Za-z", "ascii": "\\x00-\\x7F",
    "blank": "\\t ", "cntrl": "\\x00-\\x1F\\x7F", "digit": "0-9",
    "graph": "!-~", "lower": "a-z", "print": " -~",
    "punct": "!-/:-@\\[-`{-~", "space": "\\t\\n\\v\\f\\r ", "upper": "A-Z",
    "word": "0-9A-Za-z_", "xdigit": "0-9A-Fa-f",
}
GO_SPACE = "\\t\\n\\f\\r "
GO_NOT_SPACE = "\\S\\v"  # Go's \\S also takes \\v, which Python's \\s holds


def translate(p):
    out = []
    # Per open group, the flag groups in effect, each opened as a scoped
    # (?flags: group: closed before each | and reopened after it (the flags
    # carry across the alternation in Go), and closed at the group's end.
    pending = [[]]
    i, n, in_class = 0, len(p), False
    while i < n:
        c = p[i]
        if c == "\\":
            esc = p[i:i + 2]
            if in_class:
                out.append({"\\s": GO_SPACE, "\\S": GO_NOT_SPACE}.get(esc, esc))
                class_start = False
            elif esc == "\\z":
                out.append("\\Z")
            elif esc == "\\s":
                out.append("[" + GO_SPACE + "]")
            elif esc == "\\S":
                out.append("[" + GO_NOT_SPACE + "]")
            else:
                out.append(esc)
            i += 2
            continue
        if in_class:
            m = re.match(r"\[:(\^?)([a-z]+):\]", p[i:])
            if m:
                if m.group(1):
                    raise ValueError("negated POSIX class in " + p)
                out.append(POSIX[m.group(2)])
                class_start = False
                i += m.end()
                continue
            if c == "]" and not class_start:
                in_class = False
            elif c == "[":
                c = "\\["  # literal in RE2; Python warns about nested sets
            out.append(c)
            class_start = False
            i += 1
            continue
        if c == "[":
            in_class, class_start = True, True
            out.append(c)
            i += 1
            if i < n and p[i] == "^":
                out.append("^")
                i += 1
            continue
        if c == "(":
            m = re.match(r"\(\?([a-zA-Z]*(?:-[a-zA-Z]+)?)\)", p[i:])
            if m:  # (?flags): scope it to the rest of the enclosing group
                out.append("(?" + m.group(1) + ":")
                pending[-1].append(m.group(1))
                i += m.end()
                continue
            pending.append([])
            out.append(c)
            i += 1
            continue
        if c == ")":
            out.append(")" * len(pending.pop()) + ")")
            i += 1
            continue
        if c == "|" and pending[-1]:
            flags = pending[-1]
            out.append(")" * len(flags) + "|" + "".join("(?" + f + ":" for f in flags))
            i += 1
            continue
        if c == "$":
            out.append("\\Z")
            i += 1
            continue
        out.append(c)
        i += 1
    out.append(")" * len(pending.pop()))
    return "".join(out)


def join_or(patterns):
    # gitleaks joins each allowlist's patterns into one: (?:a|b|c). A flag
    # group in one alternative then carries into the ones after it, as in Go.
    return "(?:" + "|".join(patterns) + ")" if patterns else None


def allowlist(a):
    out = {
        "condition": (a.get("condition") or "OR").upper(),
        "regexTarget": a.get("regexTarget", "secret"),
        "commits": [c.strip().lower() for c in a.get("commits", [])],
        "paths": join_or(a.get("paths", [])),
        "regexes": join_or(a.get("regexes", [])),
        "stopwords": sorted({w.lower() for w in a.get("stopwords", [])}),
    }
    for k in ("paths", "regexes"):
        if out[k]:
            out[k] = translate(out[k])
    return out


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg and os.path.isfile(arg):
        raw, source = open(arg, "rb").read(), arg
    else:
        tag = arg or json.load(open(OUT))["gitleaksVersion"]
        source = "https://raw.githubusercontent.com/gitleaks/gitleaks/%s/config/gitleaks.toml" % tag
        raw = urllib.request.urlopen(source).read()
    cfg = tomllib.loads(raw.decode())
    version = arg if arg and not os.path.isfile(arg) else None

    rules = []
    for r in cfg["rules"]:
        rule = {
            "id": r["id"],
            "regex": translate(r["regex"]) if "regex" in r else None,
            "path": translate(r["path"]) if "path" in r else None,
            "entropy": r.get("entropy", 0.0),
            "secretGroup": r.get("secretGroup", 0),
            "keywords": sorted({k.lower() for k in r.get("keywords", [])}),
            "allowlists": [allowlist(a) for a in r.get("allowlists", [])],
        }
        if r.get("skipReport") or r.get("required"):
            raise SystemExit("unsupported rule feature in " + r["id"])
        rules.append(rule)
    glob = [cfg["allowlist"]] if "allowlist" in cfg else []
    glob += cfg.get("allowlists", [])

    # Every translated pattern must compile in Python
    for r in rules:
        for p in [r["regex"], r["path"]] + [x for a in r["allowlists"] for x in (a["paths"], a["regexes"])]:
            if p:
                re.compile(p, re.ASCII)

    old = json.load(open(OUT)) if os.path.exists(OUT) else {}
    data = {
        "_comment": "Generated by update-secret-rules from gitleaks' default rules "
                    "(MIT, Copyright (c) 2019 Zachary Rice; see LICENSE-gitleaks). Do not edit.",
        "gitleaksVersion": version or old.get("gitleaksVersion", "unknown"),
        "source": source,
        "allowlists": [allowlist(a) for a in glob],
        "rules": rules,
    }
    with open(OUT, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")
    print("wrote %d rules to %s" % (len(rules), OUT))


if __name__ == "__main__":
    main()

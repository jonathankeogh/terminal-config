{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/desktop-mods/usage"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(ls *)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-2[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Current date/time when the user sent this message: %s\"},\"suppressOutput\":true}' \"$(TZ='Europe/Dublin' date '+%Y-%m-%d %H:%M:%S %Z (%A)')\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "refreshInterval": 10
  },
  "cleanupPeriodDays": 3650,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "auto",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
